# Hazina Assist — environment template (never commit real values)
# NOTE: file: URLs should be ABSOLUTE for the prisma CLI (relative resolves
# against prisma/); the app normalises either form at runtime (src/lib/db.ts).
# This build is SQLite-ONLY (prisma/schema.prisma pins provider "sqlite") —
# a postgresql:// URL will NOT work until a Postgres schema/client ships.
DATABASE_URL=file:/ABSOLUTE/PATH/TO/db/custom.db

# HMAC key for signed transfer intents. Demo mode falls back to a dev value;
# DEPLOYMENT_MODE=operational FAILS CLOSED without a real ≥32-char secret.
HAZINA_INTENT_SECRET=openssl-rand-hex-32-output-here

# Deployment posture (src/lib/deployment.ts):
#   demo       — default. Synthetic data, demo identity picker, OTP code
#                revealed in the UI. NOT a production control posture.
#   operational — fails closed at startup unless: real intent secret,
#                DEMO_MODE=false, an OTP delivery provider configured, and a
#                real IdP integrated (this build has demo IAM only, so login
#                refuses in operational mode — by design).
DEPLOYMENT_MODE=demo

# OTP reveal semantics — precise: this flag only controls whether the demo
# 6-digit code is SHOWN in the chat UI (the synthetic "SMS channel").
# DEMO_MODE=false does NOT configure real SMS delivery; in operational mode
# transfers are refused entirely unless HAZINA_OTP_PROVIDER is configured.
DEMO_MODE=true

# OTP delivery provider (operational mode only): the identifier of the
# configured SMS/step-up provider. Setting a value here declares a delivery
# channel exists; without it, operational mode disables the transfer flow.
HAZINA_OTP_PROVIDER=

# Dedicated read-only scrape token for Prometheus (deploy/prometheus.yml
# sends it as a Bearer credential on /api/metrics). Rotate both sides
# together. Unset = metrics endpoint is officer-session-only.
HAZINA_METRICS_TOKEN=dev-scrape-token-change-me

CATEGORISER_URL=                # e.g. http://localhost:8001 (optional; local fallback otherwise)
PRISMA_DEBUG=                   # set to 1 to log queries
