# Hazina Assist — environment template (never commit real values)
# NOTE: file: URLs should be ABSOLUTE for the prisma CLI (relative resolves
# against prisma/); the app normalises either form at runtime (src/lib/db.ts).
DATABASE_URL=file:/ABSOLUTE/PATH/TO/db/custom.db   # postgresql://... in production
HAZINA_INTENT_SECRET=rotate-me                      # HMAC key for signed transfer intents
DEMO_MODE=true                                      # false hides OTP codes (simulates real SMS)
CATEGORISER_URL=                                    # e.g. http://localhost:8001 (optional; local fallback otherwise)
PRISMA_DEBUG=                                       # set to 1 to log queries
